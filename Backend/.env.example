# Copy this file to .env and fill in real values. Never commit .env to git.

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/gehu_erp

# Long random secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# How long login tokens stay valid
JWT_EXPIRES_IN=7d

# Port the backend listens on
PORT=5000

# Comma-separated list of origins allowed to call this API (your deployed frontend URL(s))
CLIENT_URL=https://hiicrow.site,http://localhost:5500

# Used only by seed/seed.js to create the first admin account
ADMIN_SEED_USERNAME=admin1
ADMIN_SEED_PASSWORD=change_this_password
